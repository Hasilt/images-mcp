# Copy to .env and fill in the keys for the providers you want enabled.
# Any provider left blank is skipped by search_all_images and rejected if
# queried directly via search_images.

UNSPLASH_ACCESS_KEY=
UNSPLASH_TIER=demo          # "demo" (50 req/hr) or "production" (5000 req/hr, requires Unsplash approval)

PEXELS_API_KEY=

PIXABAY_API_KEY=

FREEPIK_API_KEY=
FREEPIK_REQUESTS_PER_MINUTE=60

STOCKVAULT_API_KEY=
STOCKVAULT_REQUESTS_PER_HOUR=60

# Burst by Shopify has no official API/key; this is a self-imposed polite limit
# for the unofficial scraper.
BURST_REQUESTS_PER_MINUTE=10

DEFAULT_PROVIDER=pexels     # used when a tool call passes provider="default"
DOWNLOAD_DIR=./downloads    # relative dest_path values in download_image resolve here
